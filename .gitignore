node_modules
package-lock.json

# Tauri / Rust
src-tauri/target/
# Updater signing keys — add the public key to tauri.conf.json instead
src-tauri/.keys/
# Icon PNGs are referenced by tauri.conf.json and embedded at compile time,
# so they must be tracked (CI on Linux fails without them). Only the large
# generated .icns (macOS-only) stays ignored.
src-tauri/icons/*.icns

# SQLite runtime files (don't commit the live DB)
*.db
*.db-shm
*.db-wal
