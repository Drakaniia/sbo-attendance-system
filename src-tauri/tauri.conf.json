{
  "$schema": "https://raw.githubusercontent.com/nicoverbruggen/tauri-v2-docs/main/src/content/docs/_schema/tauri-schema.json",
  "productName": "SEATS",
  "version": "0.1.0",
  "identifier": "com.sboattendance.seats",
  "build": {
    "beforeDevCommand": "cd client && bun run dev",
    "beforeBuildCommand": "cd client && bun run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../client/dist"
  },
  "app": {
    "windows": [
      {
        "title": "SEATS",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "decorations": true,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#0A0A0A"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
