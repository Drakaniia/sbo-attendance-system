{
  "$schema": "https://raw.githubusercontent.com/nicoverbruggen/tauri-v2-docs/main/src/content/docs/_schema/tauri-schema.json",
  "productName": "SEATS",
  "version": "2.6.11",
  "identifier": "com.sboattendance.seats",
  "build": {
    "beforeDevCommand": "cd client && bun run dev",
    "beforeBuildCommand": "cd client && bun run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../client/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SEATS",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "visible": false,
        "resizable": true,
        "decorations": true,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#08090B"
      },
      {
        "label": "splashscreen",
        "title": "SEATS",
        "url": "splashscreen.html",
        "width": 440,
        "height": 360,
        "visible": true,
        "resizable": false,
        "decorations": false,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "backgroundColor": "#08090B"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Drakaniia/sbo-attendance-system/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc4NTQ2RTY4MEQ2RUU2OApSV1JvN3RhQTVrYUZCNkxES0o3RWFNelhYc0ZySUpDbGJWWTI2L0JrQWJrYVNVVHVxaU1MS3lTRwo=",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
